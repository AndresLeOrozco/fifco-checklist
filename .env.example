# Copiar este archivo como .env.local y completar los valores.
# .env.local está en .gitignore: nunca se sube al repositorio.
# En Netlify, estas mismas variables se cargan en Site configuration > Environment variables.

# --- Supabase (obligatorio) --------------------------------------------
# Supabase > Project Settings > API Keys
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Secret key (sb_secret_...). Solo servidor: ignora RLS y da acceso total.
# NUNCA ponerle el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Sección de reportes (obligatorio) ---------------------------------
# Contraseña compartida para entrar a reportes.
REPORTES_PASSWORD=cambiar-esta-contrasena
# Clave para firmar la cookie de sesión de reportes (mínimo 32 caracteres).
# Generar una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REPORTES_SESSION_SECRET=reemplazar-por-una-cadena-aleatoria-de-64-caracteres

# --- Correo con Resend (opcional) --------------------------------------
# Sin estas dos variables la app funciona igual: las inspecciones se guardan
# y cada intento de correo queda registrado como "no enviado" en el viaje.
# Resend > API Keys
RESEND_API_KEY=
# Remitente con un dominio verificado en Resend, con nombre visible:
# CORREO_REMITENTE=Checklist de flota <reportes@send.tudominio.com>
CORREO_REMITENTE=

# --- URL pública de la app (recomendado en producción) -----------------
# Se usa en los enlaces de los correos ("Ver reporte completo").
# Si se omite, se toma del dominio con que se abrió la app.
# APP_URL=https://fifco-checklist.netlify.app
APP_URL=
